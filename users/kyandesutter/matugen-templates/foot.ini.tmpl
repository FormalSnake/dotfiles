# Generated by matugen from the active wallpaper palette. Do not edit.
# Included from ~/.config/foot/foot.ini (see mixins/foot.nix). `.default`
# tokens track the active light/dark mode, so this file is rewritten on
# every mode flip and wallpaper change; foot reads it on the next launch.
#
# Slot mapping mirrors ghostty.tmpl: ANSI 1-6 and 9-14 read the eight hue
# colours config.toml declares under [config.custom_colors], slots 0 and 15
# pin to the dark scheme in both modes.
[colors-dark]
background = {{colors.background.default.hex_stripped}}
foreground = {{colors.on_surface.default.hex_stripped}}
cursor = {{colors.on_primary.default.hex_stripped}} {{colors.primary.default.hex_stripped}}
selection-background = {{colors.surface_container_highest.default.hex_stripped}}
selection-foreground = {{colors.on_surface.default.hex_stripped}}
regular0 = {{colors.surface.dark.hex_stripped}}
regular1 = {{colors.red.default.hex_stripped}}
regular2 = {{colors.green.default.hex_stripped}}
regular3 = {{colors.yellow.default.hex_stripped}}
regular4 = {{colors.blue.default.hex_stripped}}
regular5 = {{colors.magenta.default.hex_stripped}}
regular6 = {{colors.cyan.default.hex_stripped}}
regular7 = {{colors.on_surface_variant.default.hex_stripped}}
bright0 = {{colors.outline.default.hex_stripped}}
bright1 = {{colors.red_alt.default.hex_stripped}}
bright2 = {{colors.green_alt.default.hex_stripped}}
bright3 = {{colors.yellow_alt.default.hex_stripped}}
bright4 = {{colors.blue_alt.default.hex_stripped}}
bright5 = {{colors.magenta_alt.default.hex_stripped}}
bright6 = {{colors.cyan_alt.default.hex_stripped}}
bright7 = {{colors.on_surface.dark.hex_stripped}}
