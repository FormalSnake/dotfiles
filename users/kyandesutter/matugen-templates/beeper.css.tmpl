/*
 * matugen -> Beeper (Beeper Desktop v4), rendered into
 * ~/.config/BeeperTexts/custom.css, the file Beeper's
 * Settings > Appearance > Custom CSS opens. Beeper does not watch it: it reads
 * the file at launch and on its "Reload CSS" button, so a wallpaper change
 * reaches Beeper at its next start. That is why this template has no post_hook
 * (bouncing a chat client on every palette change costs more than it gives).
 *
 * Beeper's stylesheet is two layers: a base ladder (--color-base-gray-NN,
 * --color-base-system-blue-NN, --color-bg/fg/primary) and semantic tokens built
 * out of it (--color-background-app, --color-background-message-bubble-*,
 * --color-text-primary, and about a hundred more). Setting the base layer
 * carries almost all of them. Reference copy of both layers, and the source for
 * the mappings here: github.com/beeper/themes, current-v4/variables.css.
 *
 * One :root block, no @media (prefers-color-scheme). Beeper drives that query
 * from its own Appearance setting rather than from the desktop, so a template
 * split across it follows Beeper's idea of light and dark and can land inverted
 * against the shell (found 2026-09-07: e1504g in light, portal reporting light,
 * Beeper rendering the dark half). matugen has already resolved the shell's
 * mode by the time this file is written, so `.default` is the mode, and one
 * block that overrides both of Beeper's is immune to what Beeper thinks. Beeper
 * still styles its own non-token surfaces (images, embedded web views) off that
 * setting, so leaving its Appearance on "match system" is still worth doing.
 *
 * Two consequences of dropping the query, both handled below rather than left
 * to Beeper:
 *
 * - Text and icons on an accent background are hardcoded white in Beeper's
 *   sheet, which fails on M3's dark `primary` (a tone-80 pastel). They are
 *   repointed at on_primary, the role that pairs with whatever `primary` is in
 *   the resolved mode.
 * - Every translucent surface is rgba(black) in Beeper's light half and
 *   rgba(white) in its dark half, so under a wrong-mode Beeper the hovers and
 *   borders wash out. They are rebuilt at the same alphas off --color-fg, which
 *   is dark on a light palette and light on a dark one by construction.
 *
 * Nothing here sets Beeper's parallel `--*-rgb` triplets, and none may be added
 * back from the red/green/blue channel fields: under a pinned palette
 * (FormalShell's Zenbones and Flexoki wallpapers, shell/Theme/palette.js) the
 * hex fields carry the pinned colour while the channel fields still carry the
 * wallpaper-derived one, so a token and its triplet come out as two different
 * colours. Everything that consumed a triplet is redefined here off hex.
 *
 * The token names come from the community themes in that repo, which reach
 * further into the v4 UI (the preferences and command bar surfaces) than its
 * variables.css excerpt does.
 */
:root {
  --color-bg: {{colors.surface.default.hex}};
  --color-fg: {{colors.on_surface.default.hex}};
  --color-primary: {{colors.primary.default.hex}};

  /* The raw poles. Beeper's light half paints real surfaces with base-white
     (the settings cards, the elevated menus, secondary buttons), so leaving it
     literal is what put white cards under light-on-dark text when its settings
     window resolved light while its main window resolved dark. Every other
     consumer of these two (text on accent, the rgba() overlays) is redefined
     below, so repointing them at the palette is safe. */
  --color-base-white: {{colors.surface.default.hex}};
  --color-base-black: {{colors.on_surface.default.hex}};

  /* The same trap one layer down: this trio is a fixed dark grey, and Beeper's
     light half writes secondary text with it. On a themed surface that is dark
     ink on a dark card, which is what was still washing out the settings
     window after the poles were fixed. They are ink, so they take ink roles. */
  --color-base-gray-dark-50: {{colors.on_surface.default.hex}};
  --color-base-gray-dark-70: {{colors.on_surface.default.hex}};
  --color-base-gray-dark-80: {{colors.on_surface_variant.default.hex}};

  /* 10-60 are the surface ladder (app background, panels, elevated menus,
     received message bubbles at 40), 70-90 borders and disabled fills, 100-120
     text and icons. The ladder runs background to foreground in both of
     Beeper's modes, so the roles below suit either one. */
  --color-base-gray-10: {{colors.surface.default.hex}};
  --color-base-gray-20: {{colors.surface_container_low.default.hex}};
  --color-base-gray-30: {{colors.surface_container.default.hex}};
  --color-base-gray-40: {{colors.surface_container_high.default.hex}};
  --color-base-gray-50: {{colors.surface_container_high.default.hex}};
  --color-base-gray-60: {{colors.surface_container_highest.default.hex}};
  --color-base-gray-70: {{colors.outline_variant.default.hex}};
  --color-base-gray-80: {{colors.outline_variant.default.hex}};
  --color-base-gray-85: {{colors.outline.default.hex}};
  --color-base-gray-90: {{colors.outline.default.hex}};
  --color-base-gray-100: {{colors.on_surface_variant.default.hex}};
  --color-base-gray-110: {{colors.on_surface_variant.default.hex}};
  --color-base-gray-120: {{colors.on_surface.default.hex}};

  /* Accent. 90 is the resting accent surface (sent bubbles, selected thread,
     primary button), 100 and 110 its pressed steps, 80 the disabled fill.
     Material hands over one role per slot rather than a tone ramp, so the steps
     are mixed: pressed moves toward --color-fg and disabled toward --color-bg,
     which darkens on a light palette and lightens on a dark one, the direction
     Beeper's own two palettes move. */
  --color-base-system-blue-90: {{colors.primary.default.hex}};
  --color-base-system-blue-100: color-mix(in oklab, {{colors.primary.default.hex}}, {{colors.on_surface.default.hex}} 12%);
  --color-base-system-blue-110: color-mix(in oklab, {{colors.primary.default.hex}}, {{colors.on_surface.default.hex}} 20%);
  --color-base-system-blue-80: color-mix(in oklab, {{colors.primary.default.hex}}, {{colors.surface.default.hex}} 30%);

  /* On the accent: on_primary rather than Beeper's hardcoded white. */
  --color-text-on-accent: {{colors.on_primary.default.hex}};
  --color-text-on-accent-weak: color-mix(in srgb, {{colors.on_primary.default.hex}} 70%, transparent);
  --color-icon-on-accent: color-mix(in srgb, {{colors.on_primary.default.hex}} 75%, transparent);
  --color-icon-on-accent-strong: color-mix(in srgb, {{colors.on_primary.default.hex}} 90%, transparent);
  --color-icon-on-accent-weak: color-mix(in srgb, {{colors.on_primary.default.hex}} 40%, transparent);

  /* The translucent layer, at Beeper's own alphas. */
  --color-background-button-translucent: color-mix(in srgb, var(--color-fg) 10%, transparent);
  --color-background-button-translucent-active: color-mix(in srgb, var(--color-fg) 15%, transparent);
  --color-background-button-translucent-disabled: color-mix(in srgb, var(--color-fg) 5%, transparent);
  --color-background-sidebar-thread-focus: color-mix(in srgb, var(--color-fg) 10%, transparent);
  --color-background-sidebar-thread-selected-unfocused: color-mix(in srgb, var(--color-fg) 15%, transparent);
  --color-background-selected-secondary: color-mix(in srgb, var(--color-fg) 10%, transparent);
  --color-background-kbd: color-mix(in srgb, var(--color-fg) 15%, transparent);
  --color-background-scrollbar: color-mix(in srgb, var(--color-fg) 30%, transparent);
  --color-background-scrollbar-hover: color-mix(in srgb, var(--color-fg) 50%, transparent);
  --color-background-tag: color-mix(in srgb, var(--color-fg) 10%, transparent);
  --color-border-translucent: color-mix(in srgb, var(--color-fg) 10%, transparent);
  --color-border-translucent-strong: color-mix(in srgb, var(--color-fg) 15%, transparent);
  --color-border-translucent-strongest: color-mix(in srgb, var(--color-fg) 50%, transparent);
  --color-border-translucent-weak: color-mix(in srgb, var(--color-fg) 5%, transparent);
  --color-text-translucent: color-mix(in srgb, var(--color-fg) 90%, transparent);
  --color-text-translucent-subtle: color-mix(in srgb, var(--color-fg) 50%, transparent);
  --color-text-translucent-weak: color-mix(in srgb, var(--color-fg) 70%, transparent);
  --color-icon-translucent: color-mix(in srgb, var(--color-fg) 60%, transparent);
  --color-icon-translucent-strong: color-mix(in srgb, var(--color-fg) 90%, transparent);
  --color-icon-translucent-subtle: color-mix(in srgb, var(--color-fg) 30%, transparent);
  --color-icon-translucent-weak: color-mix(in srgb, var(--color-fg) 40%, transparent);

  /* The semantic layer, stated outright rather than derived. Beeper picks its
     light or dark derivation per window (its settings window and its main
     window disagreed on 2026-09-07), and only these names reach the pixels, so
     pinning them here is what makes the result independent of that. */
  --color-background-app: {{colors.surface.default.hex}};
  --color-background-app-weak: {{colors.surface_container_low.default.hex}};
  --color-background-elevated: {{colors.surface_container.default.hex}};
  --color-background-elevated-hover: {{colors.surface_container_high.default.hex}};
  --color-background-grouped: {{colors.surface_container.default.hex}};
  --color-background-grouped-weak: {{colors.surface_container_low.default.hex}};
  --color-background-object: {{colors.surface_container_high.default.hex}};
  --color-background-input: {{colors.surface_container_high.default.hex}};
  --color-background-message-active: {{colors.surface_container_high.default.hex}};
  --color-background-message-bubble-received: {{colors.surface_container_high.default.hex}};
  --color-background-message-bubble-linked: {{colors.surface.default.hex}};
  --color-background-button-secondary: {{colors.surface_container_high.default.hex}};
  --color-background-button-secondary-active: {{colors.surface_container_highest.default.hex}};
  --color-background-button-secondary-disabled: {{colors.surface_container.default.hex}};
  --color-background-menu-opaque: {{colors.surface_container_high.default.hex}};
  --color-background-header-right-opaque: {{colors.surface_container.default.hex}};
  --color-background-sidebar-opaque: {{colors.surface_container_low.default.hex}};
  --color-background-commandbar-opaque: {{colors.surface_container_high.default.hex}};
  --color-background-preferences-option-selected: {{colors.surface_container_highest.default.hex}};
  --color-surface: {{colors.surface.default.hex}};
  --color-secondary-container: {{colors.secondary_container.default.hex}};
  --color-tertiary-container: {{colors.tertiary_container.default.hex}};

  --color-background-button-primary: var(--color-base-system-blue-90);
  --color-background-button-primary-active: var(--color-base-system-blue-100);
  --color-background-button-primary-disabled: var(--color-base-system-blue-80);
  --color-background-message-bubble-sent: var(--color-base-system-blue-90);
  --color-background-selected-primary: var(--color-base-system-blue-90);
  --color-background-menu-option-hover: var(--color-base-system-blue-90);
  --color-background-selected: var(--color-base-system-blue-90);
  --color-background-sidebar-thread-selected: var(--color-base-system-blue-90);
  --color-background-commandbar-command-highlighted: var(--color-base-system-blue-90);

  --color-border-neutrals: {{colors.outline_variant.default.hex}};
  --color-border-neutrals-strong: {{colors.outline.default.hex}};
  --color-border-neutrals-weak: {{colors.surface_container_highest.default.hex}};
  --color-border-input: {{colors.outline_variant.default.hex}};
  --color-border-input-active: {{colors.outline.default.hex}};

  --color-text-neutrals: {{colors.on_surface.default.hex}};
  --color-text-neutrals-subtle: {{colors.on_surface_variant.default.hex}};
  --color-text-neutrals-weak: {{colors.on_surface_variant.default.hex}};
  --color-icon-neutrals: {{colors.on_surface_variant.default.hex}};
  --color-icon-neutrals-strong: {{colors.on_surface.default.hex}};
  --color-icon-neutrals-subtle: {{colors.outline.default.hex}};
  --color-icon-neutrals-weak: {{colors.on_surface_variant.default.hex}};
  --color-key-bottom-bg: {{colors.outline_variant.default.hex}};

  /* The three surfaces Beeper builds from a ladder entry plus alpha. */
  --color-background-sidebar: color-mix(in srgb, {{colors.surface_container_low.default.hex}} 80%, transparent);
  --color-background-header-right: color-mix(in srgb, {{colors.surface_container.default.hex}} 90%, transparent);
  --color-background-menu: color-mix(in srgb, {{colors.surface_container_high.default.hex}} 90%, transparent);
  --right-pane-bg: var(--color-bg);
}
