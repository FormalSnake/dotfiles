/*
 * matugen (DMS) -> Obsidian (Verso). Wallpaper-derived dynamic palette,
 * generated into ~/Notes/.obsidian/snippets/dank.css and hot-reloaded by
 * Obsidian on write (no reload hook needed). Enabled via appearance.json's
 * enabledCssSnippets (seeded by scripts/obsidian-vault-bootstrap.sh on Linux).
 *
 * Verso defines its palette as --verso-* tokens per .theme-light/.theme-dark and
 * maps every core Obsidian role off them, so overriding the tokens is enough --
 * the mapping downstream stays Verso's. !important is what wins here: the theme's
 * blocks are single-class (0,1,0), this one is body (0,0,1). `.default` tokens
 * track the active light/dark mode; DMS re-renders on every flip, in lockstep
 * with Obsidian's `theme: "system"`, so one block serves both modes.
 */
body {
  /* Surfaces and borders */
  --verso-bg-primary: {{colors.surface.default.hex}} !important;
  --verso-bg-secondary: {{colors.surface_container_low.default.hex}} !important;
  --verso-bg-hover: {{colors.surface_container_high.default.hex}} !important;
  --verso-tab-hover: {{colors.surface_container.default.hex}} !important;
  --verso-border-subtle: {{colors.surface_container_high.default.hex}} !important;
  --verso-tab-hairline: {{colors.surface_container_high.default.hex}} !important;
  --verso-border-muted: {{colors.outline_variant.default.hex}} !important;
  --verso-border-strong: {{colors.outline.default.hex}} !important;
  --verso-code-background: {{colors.surface_container.default.hex}} !important;
  --verso-inline-code-background: {{colors.surface_container_high.default.hex}} !important;

  /* Text */
  --verso-text-normal: {{colors.on_surface.default.hex}} !important;
  --verso-text-muted: {{colors.on_surface_variant.default.hex}} !important;
  --verso-text-faint: {{colors.outline.default.hex}} !important;

  /* Accents. Verso derives these from Obsidian's own --accent-h/s/l, which the
     palette doesn't drive, so pin the whole chain to matugen roles instead. */
  --verso-accent: {{colors.primary.default.hex}} !important;
  --verso-accent-strong: {{colors.primary.default.hex}} !important;
  --verso-accent-hover: {{colors.tertiary.default.hex}} !important;
  --verso-on-accent: {{colors.on_primary.default.hex}} !important;
  --verso-selection: {{colors.primary_container.default.hex}} !important;
  --verso-highlight: {{colors.tertiary_container.default.hex}} !important;

  /* Set to a literal by the theme, not derived from a --verso token. */
  --workspace-background-translucent: {{colors.surface.default.hex}} !important;
}
