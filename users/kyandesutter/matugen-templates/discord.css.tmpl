/*
 * matugen -> Discord (moonlight, moonlight-css extension). Wallpaper-derived
 * dynamic palette, generated into ~/.config/moonlight-mod/matugen.css and
 * loaded by moonlight-css, which chokidar-watches every local path in its
 * `paths` setting and re-injects the style element on write. No reload hook.
 *
 * This file only fills in refact0r/midnight-discord's colour ladder; the
 * mapping from that ladder onto Discord's own design tokens is colors.css,
 * pinned in mixins/discord.nix and listed ahead of this file in `paths` so
 * these :root declarations win the cascade at equal specificity.
 *
 * `container-name` is the one thing colors.css needs and doesn't carry: its
 * whole token block sits behind `@container root style(--colors: on)`, and the
 * named container is declared in main.css, which we don't load.
 *
 * `.default` tokens track the active light/dark mode, so one block serves both.
 * Status colours come from the [config.custom_colors] hues in config.toml
 * rather than Material roles, which have no green and no yellow.
 */
:root {
  container-name: root;

  /* Text. 0 is text on top of an accent, 1-2 are normal and heading text,
     3-4 channels and icon buttons, 5 muted channels and timestamps. */
  --text-0: {{colors.on_primary.default.hex}};
  --text-1: {{colors.on_surface.default.hex}};
  --text-2: {{colors.on_surface.default.hex}};
  --text-3: {{colors.on_surface_variant.default.hex}};
  --text-4: {{colors.on_surface_variant.default.hex}};
  --text-5: {{colors.outline.default.hex}};

  /* Surfaces, darkest last: 4 is the app background, 3 the spacing and
     secondary panels, 2 and 1 buttons at rest and pressed. The container
     ladder steps away from `surface` in both modes, so hover and active stay
     visible under a light palette too. */
  --bg-1: {{colors.surface_container_high.default.hex}};
  --bg-2: {{colors.surface_container.default.hex}};
  --bg-3: {{colors.surface_container_low.default.hex}};
  --bg-4: {{colors.surface.default.hex}};
  --hover: {{colors.surface_container_high.default.hex}};
  --active: {{colors.surface_container_highest.default.hex}};
  --active-2: {{colors.surface_container_highest.default.hex}};
  --message-hover: {{colors.surface_container_low.default.hex}};

  /* Accents. 4 is the hover state of an accent button, so it takes
     inverse_primary: the same hue at the opposite mode's tone, which reads as
     a step rather than a second colour. */
  --accent-1: {{colors.primary.default.hex}};
  --accent-2: {{colors.primary.default.hex}};
  --accent-3: {{colors.primary.default.hex}};
  --accent-4: {{colors.inverse_primary.default.hex}};
  --accent-5: {{colors.primary_container.default.hex}};

  /* Presence */
  --online: {{colors.green.default.hex}};
  --dnd: {{colors.red.default.hex}};
  --idle: {{colors.yellow.default.hex}};
  --streaming: {{colors.purple.default.hex}};
  --offline: {{colors.outline.default.hex}};

  /* Borders */
  --border-light: {{colors.outline_variant.default.hex}};
  --border: {{colors.outline_variant.default.hex}};
  --border-hover: {{colors.outline.default.hex}};
  --button-border: {{colors.outline_variant.default.hex}};
}

/*
 * Tokens colors.css misses at the pinned rev, in its own selector so they win
 * the same specificity fight its block does. Three kinds: Discord renamed
 * control-connect-* to control-connected-* (the voice join button); tokens
 * Discord added that colors.css never mapped, which fall through to stock
 * blurple and grey; and tokens colors.css parks on debug colours (yellow,
 * lime, magenta) as unused, which Discord's CSS still reads. Diffed against
 * discord.com/app's stylesheets on 2026-09-23.
 */
@container root style(--colors: on) {
  body,
  .theme-dark:not(.custom-user-profile-theme),
  .theme-light:not(.custom-user-profile-theme) {
    --control-connected-background-default: var(--accent-4);
    --control-connected-background-hover: var(--accent-3);
    --control-connected-background-active: var(--accent-5);
    --control-connected-border-default: var(--button-border);
    --control-connected-border-hover: var(--button-border);
    --control-connected-border-active: var(--button-border);
    --control-connected-icon-default: var(--text-0);
    --control-connected-icon-hover: var(--text-0);
    --control-connected-icon-active: var(--text-0);
    --control-connected-text-default: var(--text-0);
    --control-connected-text-hover: var(--text-0);
    --control-connected-text-active: var(--text-0);

    --interactive-background-default: var(--bg-2);
    --interactive-accent-background-default: color-mix(in hsl, var(--accent-2), transparent 85%);
    --interactive-accent-background-hover: var(--accent-3);
    --interactive-accent-background-selected: var(--accent-3);
    --interactive-accent-background-active: var(--accent-5);

    --togglebutton-background-selected: color-mix(in hsl, var(--accent-2), transparent 85%);
    --togglebutton-background-selected-hover: color-mix(in hsl, var(--accent-2), transparent 75%);
    --togglebutton-background-selected-active: var(--active);
    --togglebutton-border-selected: var(--accent-2);
    --togglebutton-border-active: var(--accent-3);
    --togglebutton-icon-default: var(--text-4);
    --togglebutton-icon-hover: var(--text-3);
    --togglebutton-icon-active: var(--text-3);
    --togglebutton-icon-selected: var(--text-2);
    --togglebutton-icon-selected-hover: var(--text-2);
    --togglebutton-icon-only-icon-default: var(--text-4);
    --togglebutton-icon-only-icon-hover: var(--text-3);
    --togglebutton-icon-only-icon-active: var(--text-3);
    --togglebutton-icon-only-icon-selected: var(--text-2);
    --togglebutton-icon-only-icon-selected-hover: var(--text-2);
    --togglebutton-critical-background-selected: color-mix(in hsl, var(--red-2), transparent 85%);
    --togglebutton-critical-background-selected-hover: color-mix(in hsl, var(--red-2), transparent 75%);
    --togglebutton-critical-border-active: var(--red-3);
    --togglebutton-critical-icon-default: var(--text-4);
    --togglebutton-critical-icon-hover: var(--text-3);
    --togglebutton-critical-icon-active: var(--red-1);
    --togglebutton-critical-icon-selected: var(--red-1);
    --togglebutton-critical-icon-selected-hover: var(--red-1);

    --tabs-indicator-default: var(--accent-2);
    --tabs-indicator-overlay: var(--text-2);
    --datepicker-range-background-default: color-mix(in hsl, var(--accent-2), transparent 60%);
    --datepicker-range-background-hover: color-mix(in hsl, var(--accent-2), transparent 40%);
    --keyword-highlight-background: color-mix(in hsl, var(--accent-2), transparent 80%);
    --icon-brand: var(--accent-2);

    --channel-background-default: var(--bg-3);
    /* Discord declares this on :root, so its var() resolves above the
       elements colors.css themes and the member list comes out black. */
    --custom-channel-members-bg: var(--background-base-lower);
    --card-border-default: var(--border);
    --card-primary-pressed-bg: var(--bg-1);
    --guild-profile-banner-background-default: var(--bg-2);

    --text-voice-connected: var(--green-1);
    --text-voice-speaking: var(--green-1);
    --text-voice-disconnected: var(--red-1);
    --icon-voice-connected: var(--green-1);
    --icon-voice-speaking: var(--green-1);
    --icon-voice-disconnected: var(--red-1);
    --background-voice-muted: color-mix(in hsl, var(--red-2), transparent 85%);
    --border-voice-muted: color-mix(in hsl, var(--red-2), transparent 85%);

    --icon-feedback-notification: var(--red-2);
    --border-feedback-info: var(--blue-2);
    --border-feedback-positive: var(--green-2);
    --border-feedback-warning: var(--yellow-2);
    --inlinenotice-border-critical: color-mix(in hsl, var(--red-2), transparent 50%);
    --inlinenotice-border-info: color-mix(in hsl, var(--blue-2), transparent 50%);
    --inlinenotice-border-positive: color-mix(in hsl, var(--green-2), transparent 50%);
    --inlinenotice-border-warning: color-mix(in hsl, var(--yellow-2), transparent 50%);
    --toast-critical-background: color-mix(in hsl, var(--red-2), transparent 85%);
    --toast-critical-border: var(--red-3);
    --toast-success-background: color-mix(in hsl, var(--green-2), transparent 85%);
    --toast-success-border: var(--green-3);
    --status-positive-text: var(--text-0);
    --status-warning-background: var(--yellow-2);
    --status-warning-text: var(--bg-4);

    --button-outline-brand-background-hover: var(--accent-3);
    --button-outline-brand-border-active: var(--accent-5);
    --control-brand-foreground-new: var(--accent-1);
    --input-border-readonly: var(--border-light);
    --scrollbar-auto-scrollbar-color-thumb: var(--bg-1);
    --scrollbar-auto-scrollbar-color-track: transparent;
    --spoiler-hidden-background: var(--bg-1);
    --spoiler-hidden-background-hover: var(--active);
    --text-overlay-dark: var(--bg-4);

    /* Nitro and profile flourishes, still read by 36 rules. */
    --expressive-gradient-blue-start: color-mix(in hsl, var(--blue-2), transparent 55%);
    --expressive-gradient-green-start: color-mix(in hsl, var(--green-2), transparent 55%);
    --expressive-gradient-green-end: color-mix(in hsl, var(--green-4), transparent 55%);
    --expressive-gradient-pink-start: color-mix(in hsl, var(--accent-2), transparent 55%);
    --expressive-gradient-pink-end: color-mix(in hsl, var(--purple-4), transparent 55%);
    --expressive-gradient-purple-start: color-mix(in hsl, var(--purple-2), transparent 55%);
    --expressive-gradient-purple-end: color-mix(in hsl, var(--purple-4), transparent 55%);
    --expressive-gradient-nitro-green-start: color-mix(in hsl, var(--green-2), transparent 50%);
    --expressive-gradient-nitro-green-end: color-mix(in hsl, var(--blue-3), transparent 50%);
    --expressive-gradient-nitro-pink-start: color-mix(in hsl, var(--accent-2), transparent 50%);
    --expressive-gradient-nitro-pink-end: color-mix(in hsl, var(--purple-3), transparent 50%);

    /* Code block syntax highlighting. */
    --text-code: var(--text-2);
    --text-code-comment: var(--text-5);
    --text-code-variable: var(--text-2);
    --text-code-keyword: var(--red-1);
    --text-code-operator: var(--red-1);
    --text-code-section: var(--red-1);
    --text-code-deletion: var(--red-1);
    --text-code-error: var(--red-1);
    --text-code-string: var(--green-1);
    --text-code-regexp: var(--green-1);
    --text-code-addition: var(--green-1);
    --text-code-title: var(--blue-1);
    --text-code-bullet: var(--blue-1);
    --text-code-attribute: var(--blue-1);
    --text-code-namespace: var(--blue-1);
    --text-code-property: var(--blue-2);
    --text-code-link: var(--accent-1);
    --text-code-builtin: var(--yellow-1);
    --text-code-decorator: var(--yellow-1);
    --text-code-number: var(--yellow-2);
    --text-code-tag: var(--purple-1);
    --text-code-type: var(--purple-1);
    --text-code-escape: var(--purple-1);
  }

  /* The call PiP draws its header on black video in every mode, but
     colors.css points --white at --text-0 (text on an accent) and the text
     tokens at the light-mode ladder, which is dark. */
  .pictureInPictureVideo_e4cb9a {
    --white: #fff;
    --text-default: #fff;
    --text-strong: #fff;
    --text-muted: rgb(255 255 255 / 0.7);
    --text-subtle: rgb(255 255 255 / 0.85);
  }
}
