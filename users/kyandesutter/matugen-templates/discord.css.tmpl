/*
 * matugen -> Discord (moonlight, moonlight-css extension). Wallpaper-derived
 * dynamic palette, generated into ~/.config/moonlight-mod/matugen.css and
 * loaded by moonlight-css, which chokidar-watches every local path in its
 * `paths` setting and re-injects the style element on write. No reload hook.
 *
 * This file only fills in refact0r/midnight-discord's colour ladder; the
 * mapping from that ladder onto Discord's own design tokens is colors.css,
 * pinned in mixins/discord.nix and listed ahead of this file in `paths` so
 * these :root declarations win the cascade at equal specificity.
 *
 * `container-name` is the one thing colors.css needs and doesn't carry: its
 * whole token block sits behind `@container root style(--colors: on)`, and the
 * named container is declared in main.css, which we don't load.
 *
 * `.default` tokens track the active light/dark mode, so one block serves both.
 * Status colours come from the [config.custom_colors] hues in config.toml
 * rather than Material roles, which have no green and no yellow.
 */
:root {
  container-name: root;

  /* Text. 0 is text on top of an accent, 1-2 are normal and heading text,
     3-4 channels and icon buttons, 5 muted channels and timestamps. */
  --text-0: {{colors.on_primary.default.hex}};
  --text-1: {{colors.on_surface.default.hex}};
  --text-2: {{colors.on_surface.default.hex}};
  --text-3: {{colors.on_surface_variant.default.hex}};
  --text-4: {{colors.on_surface_variant.default.hex}};
  --text-5: {{colors.outline.default.hex}};

  /* Surfaces, darkest last: 4 is the app background, 3 the spacing and
     secondary panels, 2 and 1 buttons at rest and pressed. The container
     ladder steps away from `surface` in both modes, so hover and active stay
     visible under a light palette too. */
  --bg-1: {{colors.surface_container_high.default.hex}};
  --bg-2: {{colors.surface_container.default.hex}};
  --bg-3: {{colors.surface_container_low.default.hex}};
  --bg-4: {{colors.surface.default.hex}};
  --hover: {{colors.surface_container_high.default.hex}};
  --active: {{colors.surface_container_highest.default.hex}};
  --active-2: {{colors.surface_container_highest.default.hex}};
  --message-hover: {{colors.surface_container_low.default.hex}};

  /* Accents. 4 is the hover state of an accent button, so it takes
     inverse_primary: the same hue at the opposite mode's tone, which reads as
     a step rather than a second colour. */
  --accent-1: {{colors.primary.default.hex}};
  --accent-2: {{colors.primary.default.hex}};
  --accent-3: {{colors.primary.default.hex}};
  --accent-4: {{colors.inverse_primary.default.hex}};
  --accent-5: {{colors.primary_container.default.hex}};

  /* Presence */
  --online: {{colors.green.default.hex}};
  --dnd: {{colors.red.default.hex}};
  --idle: {{colors.yellow.default.hex}};
  --streaming: {{colors.purple.default.hex}};
  --offline: {{colors.outline.default.hex}};

  /* Borders */
  --border-light: {{colors.outline_variant.default.hex}};
  --border: {{colors.outline_variant.default.hex}};
  --border-hover: {{colors.outline.default.hex}};
  --button-border: {{colors.outline_variant.default.hex}};
}
