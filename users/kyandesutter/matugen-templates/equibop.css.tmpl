/**
 * @name Dank
 * @description Wallpaper-derived dynamic Discord theme. Generated by matugen (DMS).
 * @author dms + refact0r/midnight-discord
 *
 * Written to ~/.config/equibop/themes/dank.theme.css. Equicord watches the
 * themes folder and hot-reloads on write, so no reload hook is needed. Enable
 * once in Equibop -> Settings -> Themes (adds it to settings/settings.json
 * enabledThemes).
 *
 * Imports midnight's colors layer only, NOT its built theme. build/midnight.css
 * also restyles the layout (rounded panels, Figtree, wider gaps); we want stock
 * Discord shape with dynamic colors. Every rule in colors.css is gated behind
 * `@container root style(--colors: on)`, and the container name normally comes
 * from main.css, so :root has to carry it here or nothing applies.
 *
 * `.default` tokens track the active light/dark mode.
 */
@import url('https://refact0r.github.io/midnight-discord/src/colors.css');

:root {
  container-name: root;

  --accent-1: {{colors.tertiary.default.hex}};
  --accent-2: {{colors.primary.default.hex}};
  --accent-3: {{colors.primary.default.hex}};
  --accent-4: {{colors.primary.default.hex}};
  --accent-5: {{colors.primary_container.default.hex}};

  /* --mention / --mention-hover stay at the colors.css defaults: a ~10% tint of
     --accent-2 over the message background. A solid colour here is unreadable,
     because the message text keeps using --text-3. */

  --text-0: {{colors.on_primary.default.hex}};
  --text-1: {{colors.on_surface.default.hex}};
  --text-2: {{colors.on_surface.default.hex}};
  --text-3: {{colors.on_surface.default.hex}};
  --text-4: {{colors.on_surface_variant.default.hex}};
  --text-5: {{colors.outline.default.hex}};

  --bg-1: {{colors.surface_container_high.default.hex}};
  --bg-2: {{colors.surface_container.default.hex}};
  --bg-3: {{colors.surface_container_low.default.hex}};
  --bg-4: {{colors.surface.default.hex}};
  --hover: {{colors.surface_bright.default.hex}};
  --active: {{colors.surface_container_highest.default.hex}};
}
