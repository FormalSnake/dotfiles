[Unit]
Description=Per-profile RAPL package power caps (quiet fans)
After=tuned-ppd.service
Wants=tuned-ppd.service
# A restarted tuned-ppd comes up in its default profile without a PropertiesChanged signal.
PartOf=tuned-ppd.service

[Service]
Type=simple
ExecStart=/usr/libexec/power-cap
Restart=always
RestartSec=2

[Install]
WantedBy=tuned-ppd.service
