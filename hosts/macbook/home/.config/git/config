[core]
	precomposeUnicode = true

# Homebrew's git sets credential.helper=osxkeychain, an ad-hoc signed helper: every git upgrade is a
# new binary to the keychain ACL, and the next read pops an "allow" dialog that hangs an agent
# shell. Apple's copy is anchor-apple signed and stays trusted.
[credential]
	helper = ""
	helper = "/Library/Developer/CommandLineTools/usr/libexec/git-core/git-credential-osxkeychain"

[credential "https://gist.github.com"]
	helper = ""
	helper = "/opt/homebrew/bin/gh auth git-credential"

[credential "https://github.com"]
	helper = ""
	helper = "/opt/homebrew/bin/gh auth git-credential"

[diff "lockb"]
	binary = true
	textconv = "bun"

[filter "lfs"]
	clean = "git-lfs clean -- %f"
	process = "git-lfs filter-process"
	required = true
	smudge = "git-lfs smudge -- %f"

[http]
	postBuffer = 157286400

[init]
	defaultBranch = "main"

[pull]
	rebase = false

