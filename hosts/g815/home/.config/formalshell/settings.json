{
  "airplay": {
    "enable": true
  },
  "bar": {
    "layout": {
      "right": [
        "display",
        "dualsense",
        "tailscale",
        "github",
        "usage",
        "chevron",
        "tray",
        "weather",
        "battery",
        "earbuds",
        "iphone",
        "audio",
        "network",
        "bluetooth",
        "bell",
        "indicators"
      ]
    },
