{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "color": "white",
    "separator": "  "
  },
  "logo": {
    "color": {
      "1": "white"
    },
    "padding": {
      "left": 1,
      "right": 2,
      "top": 1
    },
    "source": "~/.config/fastfetch/g815.txt",
    "type": "file"
  },
  "modules": [
    "break",
    {
      "key": "┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓",
      "type": "custom"
    },
    {
      "format": "{1>24} ┃",
      "key": "┃   user   ",
      "text": "echo $USER@g815",
      "type": "command"
    },
    {
      "format": "{name>24} ┃",
      "key": "┃   distro ",
      "type": "os"
    },
    {
      "format": "{release>24} ┃",
      "key": "┃   kernel ",
      "type": "kernel"
    },
    {
      "format": "{pretty-name>24} ┃",
      "key": "┃   wm     ",
      "type": "wm"
    },
    {
      "format": "{pretty-name>24} ┃",
      "key": "┃   shell  ",
      "type": "shell"
    },
    {
      "format": "{days>15}d {hours>2}h {minutes>2}m ┃",
      "key": "┃   uptime ",
      "type": "uptime"
    },
    {
      "format": "      Core Ultra 9 275HX ┃",
      "key": "┃   cpu    ",
      "type": "custom"
    },
    {
      "format": "        GeForce RTX 5070 ┃",
      "key": "┃   gpu    ",
      "type": "custom"
    },
    {
      "format": "{used>12} / {total>9} ┃",
      "key": "┃   mem    ",
      "type": "memory"
    },
    {
      "format": "{all>24} ┃",
      "key": "┃   pkgs   ",
      "type": "packages"
    },
    {
      "key": "┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛",
      "type": "custom"
    },
    "break"
  ]
}
