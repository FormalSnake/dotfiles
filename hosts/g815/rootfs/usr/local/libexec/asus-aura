#!/bin/bash
set -e

# The effect, colour and brightness are asusd's to keep across reboots (FormalShell's
# lights service sets them); nothing here sets them again.
/opt/fspec/current/bin/asusctl battery limit 80 || true
# The zones' power states (lit at boot, awake, asleep, shutdown) are asusd's too, kept in
# /etc/asusd/aura_19b6.ron: every one off since 2026-11-02, which also keeps the red breathing
# "slash" pulse off while suspended. Re-asserting them here lit the lights at every boot.
