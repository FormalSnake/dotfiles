#!/bin/sh
# dev/smoke.d/lock.sh types this password through the formalshell-lock PAM
# service. sshd takes keys only, so it opens nothing over the network.
for u in $(getent passwd | cut -d: -f1 | grep -E '^fstest[0-9]+$'); do
	usermod -p '$y$j9T$1XwN0Yw8RLnm7uMn0EnlA.$n5Tr3VdWxFwtInsHUysZeSLhJxCkEvOF6NT5bAK2TR6' "$u"
done
