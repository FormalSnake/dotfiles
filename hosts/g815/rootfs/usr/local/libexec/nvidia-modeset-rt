#!/bin/bash
# nvidia-modeset/kthread_q stamps every page flip and hands the compositor its flip
# event. It starts as SCHED_OTHER nice 0, so under a build each stamp waits behind
# the build's jobs and the compositor's vblank grid moves; under scx_bpfland, which
# g815 runs, a lower nice value barely shortens that wait and an RT class removes it.
# FIFO 2 is above formalwm's event loop (RR 1) and below PipeWire's data loop (RR 20);
# a higher class gains nothing and would let an NVKMS poll loop starve audio.
set -e

for _ in $(seq 50); do
  pid=$(ps -eo pid=,comm= | awk '$2 == "nvidia-modeset/kthread_q" { print $1 }')
  [ -n "$pid" ] && break
  sleep 0.2
done
[ -n "$pid" ] || { echo "no nvidia-modeset/kthread_q" >&2; exit 1; }
chrt -f -p 2 "$pid"
chrt -p "$pid"
