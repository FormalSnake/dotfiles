#!/bin/bash
set -o errexit
set -o nounset
set -o pipefail

dev="$1"
[ -b "$dev" ] || exit 0
# Never touch a mounted volume: the force flag below opens one happily,
# and ntfs3 keeps the dirty bit set for as long as it holds the volume
# read-write, so a mounted volume always reads dirty.
if findmnt -rn -S "$dev" >/dev/null 2>&1; then exit 0; fi

# Force, because a dirty volume is exactly what ntfsinfo refuses to open
# otherwise. It only ever reads.
flags=$(ntfsinfo -f -m "$dev" 2>/dev/null | awk '/Volume Flags:/ { print $3 }') || true
# Bit 0 of the volume flags is VOLUME_IS_DIRTY. No flags at all means ntfsinfo could not open the
# volume, which a $MFTMirr behind $MFT also causes, so that goes on to the check below.
if [ -n "$flags" ] && [ $(( flags & 1 )) -eq 0 ]; then exit 0; fi

if ! ntfsfix -n "$dev" >/dev/null 2>&1; then
  # A USB disk pulled mid-write leaves $MFTMirr behind $MFT, which ntfsfix repairs. The internal
  # volumes are Windows's own, so their damage waits for chkdsk.
  if [ "$(lsblk -dno HOTPLUG "$dev")" != 1 ]; then
    echo "$dev is dirty and the ntfsfix check pass failed: leaving it, run chkdsk from Windows" >&2
    exit 0
  fi
  echo "$dev is a removable volume left inconsistent, repairing it with ntfsfix"
fi
echo "$dev carries a stale dirty flag, clearing it"
ntfsfix -d "$dev" || echo "ntfsfix -d failed, the mount will refuse the volume" >&2
exit 0

