# The shell's only launcher, as on the real hosts: the locked login's --locked-cmd,
# hyprland.lua's start and formalwm's formalshell-start.sh start it, and a second start of a running
# unit does nothing.
[Unit]
Description=FormalShell
ConditionEnvironment=|XDG_CURRENT_DESKTOP=Hyprland
ConditionEnvironment=|XDG_CURRENT_DESKTOP=ShojiWM
PartOf=graphical-session.target

[Service]
ExecStart=/opt/fspec/current/bin/formalshell
KillMode=process
Restart=on-failure
Slice=session.slice
