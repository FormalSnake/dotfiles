[core]
	precomposeUnicode = true

[include]
	path = platform

[diff "lockb"]
	binary = true
	textconv = "bun"

[filter "lfs"]
	clean = "git-lfs clean -- %f"
	process = "git-lfs filter-process"
	required = true
	smudge = "git-lfs smudge -- %f"

[http]
	postBuffer = 157286400

[init]
	defaultBranch = "main"

[pull]
	rebase = false

