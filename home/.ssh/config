Include ~/.orbstack/ssh/config

Host e1504g
  ForwardAgent yes
  HostName 100.109.196.64
  IdentityAgent SSH_AUTH_SOCK
  User kyandesutter

Host e1504g-lan
  ForwardAgent yes
  HostName 192.168.86.116
  IdentityAgent SSH_AUTH_SOCK
  User kyandesutter

Host g815
  ForwardAgent yes
  HostName 100.114.32.78
  IdentityAgent SSH_AUTH_SOCK
  User kyandesutter

Host github.com
  AddKeysToAgent yes
  IdentityFile ~/.ssh/id_ed25519

Host gitserver
  HostName formalgit.kaiiserni.com
  Port 5173
  User kyandesutter

Host mac-codeserver
  HostName 192.168.1.36
  LocalForward 8080 127.0.0.1:8080
  User kyandesutter

Host macbook
  ForwardAgent yes
  HostName macbook-pro-2
  IdentityAgent SSH_AUTH_SOCK
  LocalForward 127.0.0.1:3200 localhost:3200
  LocalForward 127.0.0.1:3100 localhost:3100
  LocalForward 127.0.0.1:8080 localhost:8080
  LocalForward 127.0.0.1:3000 localhost:3000
  LocalForward 127.0.0.1:4322 localhost:4322
  LocalForward 127.0.0.1:3001 localhost:3001
  LocalForward 127.0.0.1:3003 localhost:3003
  LocalForward 127.0.0.1:4321 localhost:4321
  LocalForward 127.0.0.1:4983 localhost:4983
  User kyandesutter

# The macbook without the dev-port forwards: T3 Code's desktop app opens its own tunnel with
# ExitOnForwardFailure, which an interactive macbook session holding those ports would kill.
Host macbook-t3
  HostName macbook-pro-2
  IdentityAgent SSH_AUTH_SOCK
  User kyandesutter

Host superintelligence
  HostName 212.64.180.162
  User kdesutter

Host superserver
  ForwardX11 yes
  ForwardX11Trusted yes
  HostName office.kaiiserni.com
  Port 22
  User kyandesutter

Host superserver.local
  ForwardX11 yes
  ForwardX11Trusted yes
  HostName 192.168.86.2
  Port 22
  User kyandesutter

Host vm-canarycoders
  HostName 192.168.122.185
  ProxyJump superintelligence
  User kdesutter

Host windows
  HostName 100.121.238.76
  IdentityAgent SSH_AUTH_SOCK
  User kyan

Host *
  AddKeysToAgent yes
  IdentityAgent ~/.1password/agent.sock
  ServerAliveInterval 60
