IgnoreUnknown UseKeychain
Include ~/.orbstack/ssh/config

Host e1504g
  ForwardAgent yes
  HostName 100.109.196.64
  IdentityAgent SSH_AUTH_SOCK
  User kyandesutter

Host e1504g-lan
  ForwardAgent yes
  HostName 192.168.86.116
  IdentityAgent SSH_AUTH_SOCK
  User kyandesutter

Host g815
  ForwardAgent yes
  HostName 100.114.32.78
  IdentityAgent SSH_AUTH_SOCK
  User kyandesutter

Host fstestvm0 fstestvm1 fstestvm2 fstestvm3
  IdentityAgent SSH_AUTH_SOCK
  ForwardAgent yes
  HostName 127.0.0.1
  User kyan
  ProxyJump g815
