  LocalForward 127.0.0.1:3000 localhost:3000
  LocalForward 127.0.0.1:4322 localhost:4322
  LocalForward 127.0.0.1:3001 localhost:3001
  LocalForward 127.0.0.1:3003 localhost:3003
  LocalForward 127.0.0.1:4321 localhost:4321
  LocalForward 127.0.0.1:4983 localhost:4983
  User kyandesutter

# The macbook for bulk transfers (the g815's sshfs of the external SSD): its LAN address when it
# answers there, since tailscale's path between the two crosses a second router at a quarter of
# the speed, else tailscale. ssh keeps the first HostName it reads, so the Match comes first.
Match originalhost macbook-drive exec "ping -c1 -W1 macbook-pro-2.local >/dev/null 2>&1"
  HostName macbook-pro-2.local

Host macbook-drive
  HostName macbook-pro-2
  HostKeyAlias macbook-pro-2
  IdentityAgent SSH_AUTH_SOCK
  User kyandesutter

# The macbook without the dev-port forwards: T3 Code's desktop app opens its own tunnel with
# ExitOnForwardFailure, which an interactive macbook session holding those ports would kill.
Host macbook-t3
  HostName macbook-pro-2
  IdentityAgent SSH_AUTH_SOCK
  User kyandesutter

