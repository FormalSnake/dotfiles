-- Generated by matugen on every palette change (wallpaper pick / light-dark
-- flip). Two consumers, both in users/kyandesutter/mixins/hyprland.nix:
--   • the config's trailing `pcall(dofile, ...)` re-applies it on every eval,
--     so a `hyprctl reload` doesn't drop back to the static Flexoki fallback
--     in `general.col`;
--   • the template's post_hook in mixins/dms.nix runs the same dofile through
--     `hyprctl eval`, so the colours land instantly without a reload.
-- Absent before the first render: the pcall is what makes that safe.
-- primary = active border; outline = inactive (surface was invisible against
-- the wallpaper once gaps opened the layout up; outline is M3's mid-tone made
-- for exactly this).
hl.config({
  general = {
    col = {
      active_border = "rgb({{ colors.primary.default.hex_stripped }})",
      inactive_border = "rgb({{ colors.outline.default.hex_stripped }})",
    },
  },
})
