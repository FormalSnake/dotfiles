# Generated by matugen from the active wallpaper palette. Do not edit.
# Loaded by ghostty via `theme = "Matugen"` (see mixins/ghostty.nix).
# `.default` tokens track the active light/dark mode, so this file is
# rewritten (and ghostty SIGUSR2-reloaded) on every mode flip and wallpaper
# change.
#
# ANSI 1-6 and 9-14 read the eight hue colours config.toml declares under
# [config.custom_colors], not Material's primary/secondary/tertiary: Material
# carries no green and no yellow, so a slot mapped onto it paints those in the
# accent's hue and the terminal comes out one colour end to end. Slots 0 and
# 15 pin to the dark scheme in both modes, which is where Flexoki's own
# terminal port puts black and bright white.
background = {{colors.background.default.hex}}
foreground = {{colors.on_surface.default.hex}}
cursor-color = {{colors.primary.default.hex}}
cursor-text = {{colors.on_primary.default.hex}}
selection-background = {{colors.surface_container_highest.default.hex}}
selection-foreground = {{colors.on_surface.default.hex}}
palette = 0={{colors.surface.dark.hex}}
palette = 1={{colors.red.default.hex}}
palette = 2={{colors.green.default.hex}}
palette = 3={{colors.yellow.default.hex}}
palette = 4={{colors.blue.default.hex}}
palette = 5={{colors.magenta.default.hex}}
palette = 6={{colors.cyan.default.hex}}
palette = 7={{colors.on_surface_variant.default.hex}}
palette = 8={{colors.outline.default.hex}}
palette = 9={{colors.red_alt.default.hex}}
palette = 10={{colors.green_alt.default.hex}}
palette = 11={{colors.yellow_alt.default.hex}}
palette = 12={{colors.blue_alt.default.hex}}
palette = 13={{colors.magenta_alt.default.hex}}
palette = 14={{colors.cyan_alt.default.hex}}
palette = 15={{colors.on_surface.dark.hex}}
