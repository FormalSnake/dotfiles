#!/usr/bin/bash
set -o nounset
set -o pipefail

# norduserd registers its tray icon on two D-Bus connections, so the tray shows two NordVPN
# entries. The CLI drives everything here; the setting lives in NordVPN's vault and is gone after
# a reset, so it is re-applied each session.
for _ in $(seq 1 30); do
  /usr/bin/nordvpn settings >/dev/null 2>&1 && break
  sleep 1
done

# `set tray off` exits 1 when already off, so only flip it while enabled.
if /usr/bin/nordvpn settings 2>/dev/null | grep -qi 'Tray: enabled'; then
  /usr/bin/nordvpn set tray off
fi
