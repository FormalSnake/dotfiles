#!/bin/sh
# Renders the boot theme in /usr/local/share/formalos-boot into the greeter's copy of the boot
# screen's finished frame and Limine's wallpaper, rebuilds the initrds when the theme, formalboot
# or dracut's config changed, and keeps Limine's EFI binary on the ESP current.
# Limine goes first in the firmware boot order only after a boot came through it; until then it
# gets a single BootNext try, so a Limine that cannot boot leaves systemd-boot first.
set -eu
src=/usr/local/share/formalos-boot
esp=/boot/efi
state=/var/lib/formalos-boot
formalboot=/opt/fspec/current/bin/formalboot
dracut=/usr/lib/dracut/modules.d/90formalboot
frames=/usr/share/formalboot
. "$src/theme.env"
limine=$esp/EFI/limine
# An apply writes the theme, which starts this, before it switches the store to the generation
# that carries formalboot.
for _ in $(seq 120); do
	[ -x "$formalboot" ] && [ -f "$dracut/module-setup.sh" ] && break
	sleep 1
done
mkdir -p "$state" "$limine"

sum=$(cat "$src"/* "$formalboot" "$dracut"/* /etc/dracut.conf.d/* /etc/systemd/system/formalboot.service | sha256sum | cut -d ' ' -f 1)
if [ "$sum" != "$(cat "$state/theme.sum" 2>/dev/null)" ] || [ ! -f "$limine/$name.png" ] || [ ! -f "$frames/greeter-1.png" ]; then
	# The finished frame at each scale formalboot draws at, for the first greeter's sway and the
	# session's lock to show centred over the frame formalboot leaves.
	rm -rf "$frames.new"
	mkdir -p "$frames.new"
	for s in 1 2 3 4; do
		"$formalboot" frame --theme "$src" --scale "$s" --out "$frames.new/greeter-$s.png"
	done
	rm -rf "$frames"
	mv "$frames.new" "$frames"
	rm -rf "/usr/share/plymouth/themes/$name"
	# Limine centres the wallpaper and the menu on the same point, so the logo sits at the top of a
	# tall canvas to land above the entries.
	magick -size "$wallpaper_size" "xc:#$backdrop" \( "$src/logo.png" -filter point -resize "$wallpaper_scale"00% \) \
		-gravity north -composite "png24:$limine/$name.png.new"
	mv "$limine/$name.png.new" "$limine/$name.png"
	dracut --force --regenerate-all
	systemctl start fspec-esp-sync.service
	echo "$sum" >"$state/theme.sum"
fi

if ! cmp -s /usr/share/limine/BOOTX64.EFI "$limine/BOOTX64.EFI"; then
	cp /usr/share/limine/BOOTX64.EFI "$limine/BOOTX64.EFI.new"
	mv "$limine/BOOTX64.EFI.new" "$limine/BOOTX64.EFI"
fi

entry() {
	efibootmgr | grep -i '\\efi\\limine\\bootx64\.efi' | sed -n 's/^Boot\([0-9A-F]\{4\}\).*/\1/p' | head -n 1
}
order() {
	efibootmgr | sed -n 's/^BootOrder: //p'
}
num=$(entry)
if [ -z "$num" ]; then
	was=$(order)
	part=$(findmnt -no SOURCE "$esp")
	efibootmgr -q -c -d "/dev/$(lsblk -no PKNAME "$part")" -p "$(cat "/sys/class/block/${part##*/}/partition")" \
		-L Limine -l '\EFI\limine\BOOTX64.EFI'
	num=$(entry)
	efibootmgr -q -o "${was:+$was,}$num"
fi
case $(order) in
"$num" | "$num",*) ;;
*)
	if [ "$(efibootmgr | sed -n 's/^BootCurrent: //p')" = "$num" ]; then
		rest=$(order | tr , '\n' | grep -vx "$num" | paste -sd , -)
		efibootmgr -q -o "$num${rest:+,$rest}"
	elif [ ! -e "$state/limine-tried" ]; then
		efibootmgr -q -n "$num"
		touch "$state/limine-tried"
	else
		echo "formalos-boot: Limine (Boot$num) has not booted this machine; systemd-boot stays first" >&2
	fi
	;;
esac
