--- a/src/Overview.cpp
+++ b/src/Overview.cpp
@@ -1390,7 +1390,15 @@ COverview::COverview(PHLWORKSPACE startedOn_, PHLMONITOR monitor_, bool swipe_,
         if (!TARGET && !SOURCE)
             return;
 
-        info.cancelled = true;
+        // A release whose press reached a client before the overview opened (a drag
+        // a panel handed over) goes on to Hyprland as well: cancelled, it stays in
+        // Hyprland's held buttons and pins pointer focus to that client until the
+        // next release anywhere. Presses are kept per session, so one left behind by
+        // an overview closed with the button down never matches a later session.
+        static std::vector<std::pair<uint64_t, uint32_t>> ownPresses;
+        const std::pair<uint64_t, uint32_t> PRESS = {m_sessionGeneration, event.button};
+        std::erase_if(ownPresses, [&](const auto& p) { return p.first != PRESS.first; });
+        info.cancelled = event.state == WL_POINTER_BUTTON_STATE_PRESSED || std::erase(ownPresses, PRESS) > 0;
         const bool dragDropEnabled = HyprlandAPI::intValue("plugin:hyprexpo:drag_drop_enable");
 
         // If expo hasn't animated in enough to be visible, close silently without
@@ -1402,6 +1410,7 @@ COverview::COverview(PHLWORKSPACE startedOn_, PHLMONITOR monitor_, bool swipe_,
         }
 
         if (event.state == WL_POINTER_BUTTON_STATE_PRESSED) {
+            ownPresses.push_back(PRESS);
             if (dragDropEnabled && TARGET)
                 TARGET->beginWindowDrag();
