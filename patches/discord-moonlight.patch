+const fs = require("fs");
+const os = require("os");
+const path = require("path");
+// The launcher keeps a writable moonlight here so moonbase can update it; the packaged one is the fallback.
+const home = path.join(process.env.XDG_DATA_HOME || path.join(os.homedir(), ".local/share"), "moonlight-mod/dist/injector.js");
+const injector = fs.existsSync(home) ? home : path.join(__dirname, "../../../moonlight/injector.js");
+require(injector).inject(path.join(__dirname, "../_app.asar"));
