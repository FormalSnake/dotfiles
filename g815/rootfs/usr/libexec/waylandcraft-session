#!/bin/bash
# Minecraft as the desktop: Prism Launcher's waylandcraft instance under cage, on HDMI-A-1 while it
# is connected.
export __GL_THREADED_OPTIMIZATIONS=0
for status in /sys/class/drm/card*-HDMI-A-1/status; do
  if [ "$(cat "$status")" = connected ]; then
    export WLR_DRM_CONNECTORS=HDMI-A-1
  fi
done
cfg="${XDG_DATA_HOME:-$HOME/.local/share}/PrismLauncher/instances/waylandcraft/instance.cfg"
if [ -f "$cfg" ]; then
  for kv in OverrideMiscellaneous=true QuitAfterGameStop=true CloseAfterLaunch=false; do
    key=${kv%%=*}
    if grep -q "^$key=" "$cfg"; then
      sed -i "s/^$key=.*/$kv/" "$cfg"
    else
      sed -i "/^\[General\]/a $kv" "$cfg"
    fi
  done
fi
exec cage -s -- prismlauncher --launch waylandcraft
